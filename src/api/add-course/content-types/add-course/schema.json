{
  "kind": "collectionType",
  "collectionName": "add_courses",
  "info": {
    "singularName": "add-course",
    "pluralName": "add-courses",
    "displayName": "Add course",
    "description": ""
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "Coursename": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "description": {
      "type": "blocks"
    },
    "trophy": {
      "type": "integer"
    },
    "all_exercises": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::all-exercise.all-exercise",
      "inversedBy": "add_courses"
    },
    "image": {
      "type": "media",
      "multiple": true,
      "required": false,
      "allowedTypes": [
        "images"
      ]
    },
    "workout_records": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::workout-record.workout-record",
      "mappedBy": "add_course"
    },
    "user": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "plugin::users-permissions.user",
      "inversedBy": "add_courses"
    }
  }
}
