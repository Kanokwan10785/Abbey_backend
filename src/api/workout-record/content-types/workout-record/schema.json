{
  "kind": "collectionType",
  "collectionName": "workout_records",
  "info": {
    "singularName": "workout-record",
    "pluralName": "workout-records",
    "displayName": "WorkoutRecord",
    "description": ""
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "week": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::week.week",
      "inversedBy": "workout_records"
    },
    "day": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::day.day",
      "inversedBy": "workout_records"
    },
    "status": {
      "type": "boolean"
    },
    "timestamp": {
      "type": "date"
    },
    "exercise_level": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::exercise-level.exercise-level",
      "inversedBy": "workout_records"
    },
    "exercise_levels": {
      "type": "enumeration",
      "enum": [
        "legs_advanced",
        "legs_intermediate",
        "legs_beginner",
        "arms_advanced",
        "arms_intermediate",
        "arms_beginner",
        "back_advanced",
        "back_intermediate",
        "back_beginner",
        "chest_advanced",
        "chest_intermediate",
        "chest_beginner"
      ]
    },
    "users_permissions_user": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "plugin::users-permissions.user",
      "inversedBy": "workout_records"
    },
    "add_course": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::add-course.add-course",
      "inversedBy": "workout_records"
    },
    "add_courses": {
      "type": "enumeration",
      "enum": [
        "back pain",
        "neck pain"
      ]
    },
    "missed": {
      "type": "boolean"
    },
    "resetTimestamp": {
      "type": "date"
    }
  }
}
